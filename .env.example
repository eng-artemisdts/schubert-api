PORT=3001
NODE_ENV=development
MONGODB_URI=
WEB_APP_ORIGIN=http://localhost:3000

# Desenvolvimento: ignora validação JWT (só com NODE_ENV=development). Nunca ativar em produção.
# DEV_AUTH_BYPASS=1
# DEV_AUTH_BYPASS_SUB=auth0|dev-local-bypass
# DEV_AUTH_BYPASS_PLAN=pro

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

# YouTube Data API — usada na enriquecimento opcional do `youtubeUrl` durante a ingestão.
YOUTUBE_DATA_API_KEY=

# Storage do áudio de ingest (player interno no cifra.ai-web)
# Providers suportados: noop | s3
AUDIO_STORAGE_PROVIDER=noop
AUDIO_STORAGE_PUBLIC_BASE_URL=
AUDIO_STORAGE_S3_REGION=
AUDIO_STORAGE_S3_BUCKET=
AUDIO_STORAGE_S3_ACCESS_KEY_ID=
AUDIO_STORAGE_S3_SECRET_ACCESS_KEY=
AUDIO_STORAGE_S3_KEY_PREFIX=ingest-audio

# Ingest async + filas (obrigatório para ingestão Spotify-fonte)
INGEST_ASYNC_ENABLED=0
REDIS_URL=redis://127.0.0.1:6379
INGEST_CACHE_PROVIDER=redis
INGEST_QUEUE_CONCURRENCY=1
INGEST_QUEUE_ATTEMPTS=3
INGEST_QUEUE_BACKOFF_MS=1000
INGEST_QUEUE_KEEP_LOGS=500

# Bull Board
BULLBOARD_ENABLED=1

# ─── Extração de áudio por URL (yt-dlp + ffmpeg no servidor) ─────────────────

YTDLP_BINARY=/usr/local/bin/yt-dlp
FFMPEG_BINARY=/usr/bin/ffmpeg

AUDIO_MAX_DURATION_SEC=600

TIKTOK_COOKIES_FILE=/etc/schubert/tiktok-cookies.txt
INSTAGRAM_COOKIES_FILE=/etc/schubert/ig-cookies.txt

# Spotify — metadata apenas (áudio vem do YouTube via yt-dlp após YoutubeSearchPort)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=